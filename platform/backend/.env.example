# Copy to .env and fill in. Leave PLATFORM_DATABASE_URL unset to use the
# local SQLite file (data/warehouse/platform.db).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
PLATFORM_DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/platform

# ANTHROPIC_API_KEY=
